# SentinelOps Environment Configuration Template
# Copy this file to .env before starting Docker Compose.

# PostgreSQL Database Configuration
POSTGRES_DB=incident_platform
POSTGRES_USER=incident_app
POSTGRES_PASSWORD=change-this-development-password
DATABASE_URL=postgresql+psycopg://incident_app:change-this-development-password@postgres:5432/incident_platform

# Security & JWT Configuration
# Generate a unique production secret, e.g. with: openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-64-character-random-secret-before-starting
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Frontend URLs
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Storage & Upload Limits (Phase 7)
MAX_UPLOAD_SIZE=10485760
